# Copy this file to .env and fill in the values marked CHANGE_ME.
# docker-compose reads this file automatically from the project root.

# ── Your droplet's public IP ───────────────────────────────────────────────
# Used to build the URLs baked into the admin dashboard and (for API calls)
# the storefront at build time — the backend itself stays IP:port-only for
# now, no domain, even once DOMAIN below is live. Also the image URL the
# backend returns to clients.
DROPLET_IP=CHANGE_ME_167_99_x_x

# ── Storefront domain (HTTPS via nginx + Let's Encrypt) ────────────────────
# Only the storefront (cust-fe) is served on this domain — see nginx/ and
# DEPLOY.md. Point this domain's A record (and www's) at DROPLET_IP before
# running init-letsencrypt.sh.
DOMAIN=yunshang.com.sg
# Let's Encrypt sends renewal-failure notices here — required by certbot.
CERTBOT_EMAIL=CHANGE_ME_you@example.com

# ── Database ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_pick_a_strong_password
DB_NAME=yunshang

# ── Backend auth ─────────────────────────────────────────────────────────
# Pre-generated for you — safe to use as-is, but rotate if this file is ever
# shared or committed anywhere.
JWT_SECRET_KEY=3084099b9d806f425a2a1313eaeed0ef2e0c0bc70112589eef0fd7c81295713041cac5a2e137da3fe5ea65e175c10579
ADMIN_EMAIL=admin@yunshang.com.sg
ADMIN_PASSWORD=kLBuoo0FeqH

# Leave blank to skip captcha verification on signup/login.
CAPTCHA_KEY=

# ── SendGrid (order confirmation / password reset emails) ─────────────────
SENDGRID_API_KEY=CHANGE_ME_or_leave_blank_to_skip_email
SENDGRID_FROM_EMAIL=no-reply@yunshang.com.sg

# ── Company details (shown on the invoice/delivery order document) ────────
COMPANY_NAME=Yun Shang Pte Ltd
COMPANY_ADDRESS=Singapore
COMPANY_PHONE=+65 6123 4567
COMPANY_EMAIL=admin@yunshang.com.sg
COMPANY_UEN=
GST_ENABLED=false
GST_RATE=9

# ── Storefront WhatsApp button ─────────────────────────────────────────────
# Digits only, with country code, no "+" or spaces (e.g. 6591234567).
# Leave blank to hide the floating WhatsApp button until the client provides
# a number.
WHATSAPP_NUMBER=6589835830
