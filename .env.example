# Copy this file to .env and fill in the values marked CHANGE_ME.
# docker-compose reads this file automatically from the project root.

# ── Your droplet's public IP (no domain yet) ──────────────────────────────
# Used to build the URLs baked into the admin and storefront frontends at
# build time, and the image URL the backend returns to clients.
DROPLET_IP=CHANGE_ME_167_99_x_x

# ── Database ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_pick_a_strong_password
DB_NAME=yunshang

# ── Backend auth ─────────────────────────────────────────────────────────
# Pre-generated for you — safe to use as-is, but rotate if this file is ever
# shared or committed anywhere.
JWT_SECRET_KEY=3084099b9d806f425a2a1313eaeed0ef2e0c0bc70112589eef0fd7c81295713041cac5a2e137da3fe5ea65e175c10579
ADMIN_EMAIL=admin@yunshang.sg
ADMIN_PASSWORD=kLBuoo0FeqH

# Leave blank to skip captcha verification on signup/login.
CAPTCHA_KEY=

# ── SendGrid (order confirmation / password reset emails) ─────────────────
SENDGRID_API_KEY=CHANGE_ME_or_leave_blank_to_skip_email
SENDGRID_FROM_EMAIL=no-reply@yunshang.sg

# ── Company details (shown on the invoice/delivery order document) ────────
COMPANY_NAME=Yun Shang Pte Ltd
COMPANY_ADDRESS=Singapore
COMPANY_PHONE=+65 6123 4567
