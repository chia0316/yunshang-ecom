# Proxies to cust-fe only — the backend and admin-fe are deliberately not
# reachable through this domain, they stay IP:port-only until their own
# domain/API routing is set up later (see DEPLOY.md).
#
# ${DOMAIN} is substituted at container startup from the nginx service's
# environment (see docker-compose.yml); everything else here ($host,
# $remote_addr, etc.) are nginx's own runtime variables and are left as-is.

# Docker's embedded DNS — resolves cust-fe at request time instead of once
# at nginx startup, so nginx doesn't fail to boot (or go stale) if cust-fe
# isn't up yet or gets recreated later.
resolver 127.0.0.11 valid=10s;

# yunshang.com.sg / www.yunshang.com.sg — redirect to HTTPS, except for the
# ACME HTTP-01 challenge path certbot needs to issue/renew the certificate.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Anything else on port 80 (i.e. the bare droplet IP) — plain HTTP straight
# to the storefront, no redirect. This is the "cust-fe by IP for testing"
# path; there's no valid cert for a raw IP so it isn't pushed to HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location / {
        set $upstream_custfe http://cust-fe:80;
        proxy_pass $upstream_custfe;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        set $upstream_custfe http://cust-fe:80;
        proxy_pass $upstream_custfe;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
