# Everything lives on this one domain now: storefront at /, admin dashboard
# at /admin, backend API at /api. No IP-based access — a request that
# doesn't carry the right Host header just falls through to the HTTPS
# redirect below and fails TLS (no cert issued for a raw IP), which is the
# intended "not reachable that way anymore" outcome.
#
# ${DOMAIN} is substituted at container startup from the nginx service's
# environment (see docker-compose.yml); everything else here ($host,
# $remote_addr, etc.) are nginx's own runtime variables and are left as-is.

# Docker's embedded DNS — resolves each upstream at request time instead of
# once at nginx startup, so nginx doesn't fail to boot (or go stale) if an
# upstream isn't up yet or gets recreated later.
resolver 127.0.0.11 valid=10s;

# yunshang.com.sg / www.yunshang.com.sg — redirect to HTTPS, except for the
# ACME HTTP-01 challenge path certbot needs to issue/renew the certificate.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Backend API — /api/products, /user/login, /static/images/... on the
    # backend side all lose their /api prefix here (proxy_pass's trailing
    # "/" replaces the /api/ the location matched), which is what makes
    # both prefixed routes (/api/products) and unprefixed ones
    # (/user/login, /static/...) resolve correctly on the other side —
    # the backend's own route mounting is a mix of both.
    #
    # Deliberately a literal target here, NOT a $variable like the other
    # locations below — nginx only performs this prefix-replacement rewrite
    # (matched /api/ -> proxy_pass's trailing "/") when the target is
    # static. With a variable, the request's actual path is discarded
    # entirely and every request lands on the bare backend root instead —
    # a real, documented nginx gotcha, not a hypothetical one (confirmed
    # live: /api/api/category was returning the root health-check payload
    # instead of the category list). The tradeoff is backend's hostname is
    # now resolved once at nginx startup instead of per-request, which is
    # fine since docker-compose's depends_on already sequences backend
    # before nginx.
    location /api/ {
        proxy_pass http://backend:8090/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 500M;
    }

    # Admin dashboard — no prefix stripping here, unlike /api above. Next.js
    # is built with basePath "/admin" (see admin-FE/next.config.ts), so it
    # expects to keep seeing "/admin" in the request path itself.
    location /admin {
        set $upstream_adminfe http://admin-fe:3000;
        proxy_pass $upstream_adminfe;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Storefront — everything else.
    location / {
        set $upstream_custfe http://cust-fe:80;
        proxy_pass $upstream_custfe;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
